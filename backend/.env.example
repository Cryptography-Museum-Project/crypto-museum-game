# Скопируй этот файл в .env и поменяй значения перед запуском на реальном сервере.
# .env в git не попадает (см. .gitignore) — секреты остаются только у тебя.

# Для локальной разработки можно ничего не менять — SQLite создаст файл game.db сам.
DATABASE_URL=sqlite:///./game.db

# ВАЖНО: замени на длинную случайную строку перед деплоем на сервер.
# Сгенерировать такую строку можно командой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=240

# Логин/пароль администратора, который создаётся автоматически при первом запуске.
# Смени пароль после первого входа в реальной эксплуатации.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# С каких адресов разрешено обращаться к API. "*" — с любых (ок для разработки).
# Для сервера лучше указать точный адрес фронтенда, например:
# CORS_ALLOW_ORIGINS=https://key-to-trust.ru
CORS_ALLOW_ORIGINS=*
