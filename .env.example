# перед запуском на сервере. Файл .env в git не попадает.

# Порт, на котором будет открываться приложение.
# На сервере обычно 80 (или порт, на который смотрит ваш прокси с HTTPS).
APP_PORT=8080

# Длинная случайная строка для подписи токенов входа в админку.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=240

# Учётная запись администратора, создаётся только при ПЕРВОМ запуске
# (когда база ещё пустая). Задайте свой пароль ДО первого запуска.
# Как сменить пароль позже — см. README, раздел 3.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
